rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isPremiumUser() {
      return isSignedIn()
        && (
          userDoc().role == 'owner'
          || userDoc().plan in ['pro', 'enterprise_master']
        );
    }

    // Perfil do utilizador — leitura própria; créditos/plano/role só via Admin SDK
    // (exceto bootstrap inicial: doc sem credits → 50 free).
    // Token GitHub NUNCA neste doc — só em users/{uid}/secrets/* (Admin).
    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.plan == 'free'
        && request.resource.data.credits == 50
        && (!('role' in request.resource.data) || request.resource.data.role == 'user')
        && !('secrets' in request.resource.data);

      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['github', 'integrations', 'role', 'lastCreditReset'])
        && (
          // Atualização de perfil: credits e plan imutáveis no cliente
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['credits', 'plan'])
          // Migração: doc antigo sem credits → free + 50
          || (
            !('credits' in resource.data)
            && request.resource.data.credits == 50
            && request.resource.data.plan == 'free'
            && (!('role' in request.resource.data) || request.resource.data.role == 'user')
          )
        );
      allow delete: if false;

      // Segredos (ex.: accessToken GitHub) — só Admin SDK
      match /secrets/{secretId} {
        allow read, write: if false;
      }
    }

    // Compras / packs — utilizador lê as suas; writes de conclusão via Admin/webhooks
    match /transactions/{txId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll([
          'userId', 'amount', 'credits', 'type', 'status', 'createdAt'
        ]);

      allow update, delete: if false;
    }

    match /projects/{projectId} {
      // Owner can read/update/delete their project doc (create checks request.resource).
      allow read, update, delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.ownerId;

      function isProjectOwner() {
        return isSignedIn()
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId
            == request.auth.uid;
      }

      match /messages/{messageId} {
        allow read, write: if isProjectOwner();
      }

      match /automations/{automationId} {
        allow read, write: if isProjectOwner();
      }

      match /automationRuns/{runId} {
        allow read, write: if isProjectOwner();
      }

      // Schema / mock DB entities (Base44-style)
      match /entities/{entityId} {
        allow read, write: if isProjectOwner();

        match /rows/{rowId} {
          allow read, write: if isProjectOwner();
        }
      }
    }

    // Publicações partilháveis — leitura aberta (só snapshot de ficheiros, sem chat).
    // Preview: qualquer owner do projeto.
    // Production: só Pro / Owner (role/plan no user doc Admin); writes Admin via /api/deploy também.
    match /publicProjects/{pubId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'projectId', 'ownerId', 'name', 'env', 'files', 'url', 'updatedAt'
        ])
        && request.resource.data.env in ['preview', 'production']
        && (!('plan' in request.resource.data)
          || request.resource.data.plan in ['free', 'pro', 'enterprise_master'])
        && (!('showBadge' in request.resource.data)
          || request.resource.data.showBadge is bool)
        && (
          request.resource.data.env == 'preview'
          || isPremiumUser()
        );

      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.env in ['preview', 'production']
        && (
          request.resource.data.env == 'preview'
          || isPremiumUser()
        );

      allow delete: if isSignedIn()
        && (
          resource.data.ownerId == request.auth.uid
          || (
            'projectId' in resource.data
            && get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.ownerId
              == request.auth.uid
          )
        );
    }
  }
}
