rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isPremiumUser() {
      return isSignedIn()
        && (
          userDoc().role == 'owner'
          || userDoc().plan in ['pro', 'enterprise_master']
        );
    }

    // Perfil do utilizador — leitura própria; créditos/plano/role só via Admin SDK
    // (exceto bootstrap inicial: doc sem credits → 50 free).
    // Token GitHub NUNCA neste doc — só em users/{uid}/secrets/* (Admin).
    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.plan == 'free'
        && request.resource.data.credits == 50
        && (!('role' in request.resource.data) || request.resource.data.role == 'user')
        && !('secrets' in request.resource.data);

      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['github', 'integrations', 'role', 'lastCreditReset'])
        && (
          // Atualização de perfil: credits e plan imutáveis no cliente
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['credits', 'plan'])
          // Migração: doc antigo sem credits → free + 50
          || (
            !('credits' in resource.data)
            && request.resource.data.credits == 50
            && request.resource.data.plan == 'free'
            && (!('role' in request.resource.data) || request.resource.data.role == 'user')
          )
        );
      allow delete: if false;

      // Segredos (ex.: accessToken GitHub) — só Admin SDK
      match /secrets/{secretId} {
        allow read, write: if false;
      }

      // Sessões / dispositivos — só Admin SDK
      match /sessions/{sessionId} {
        allow read, write: if false;
      }
    }

    // Compras / packs — utilizador lê as suas; writes de conclusão via Admin/webhooks
    match /transactions/{txId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll([
          'userId', 'amount', 'credits', 'type', 'status', 'createdAt'
        ]);

      allow update, delete: if false;
    }

    match /projects/{projectId} {
      function projectData() {
        return get(/databases/$(database)/documents/projects/$(projectId)).data;
      }

      function authEmail() {
        return request.auth != null && request.auth.token.email != null
          ? request.auth.token.email
          : '';
      }

      function isProjectOwner() {
        return isSignedIn()
          && projectData().ownerId == request.auth.uid;
      }

      function isProjectEditor() {
        return isSignedIn()
          && (
            isProjectOwner()
            || (
              'collaboratorEditorEmails' in projectData()
              && authEmail() in projectData().collaboratorEditorEmails
            )
          );
      }

      function isProjectMember() {
        return isSignedIn()
          && (
            isProjectOwner()
            || (
              'collaboratorEmails' in projectData()
              && authEmail() in projectData().collaboratorEmails
            )
          );
      }

      // Owner + collaborators can read; write = owner or editor
      allow read: if isSignedIn()
        && (
          resource.data.ownerId == request.auth.uid
          || (
            'collaboratorEmails' in resource.data
            && authEmail() in resource.data.collaboratorEmails
          )
        );
      allow update: if isSignedIn()
        && (
          resource.data.ownerId == request.auth.uid
          || (
            'collaboratorEditorEmails' in resource.data
            && authEmail() in resource.data.collaboratorEditorEmails
          )
        )
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['ownerId', 'collaborators', 'collaboratorEmails', 'collaboratorEditorEmails']);
      // Collaborators list only via Admin SDK / owner API — owners may still update other fields via client
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.ownerId;

      match /messages/{messageId} {
        allow read: if isProjectMember();
        allow write: if isProjectEditor();
      }

      match /automations/{automationId} {
        allow read: if isProjectMember();
        allow write: if isProjectEditor();
      }

      match /automationRuns/{runId} {
        allow read: if isProjectMember();
        allow write: if isProjectEditor();
      }

      // Schema / mock DB entities (Base44-style)
      match /entities/{entityId} {
        allow read: if isProjectMember();
        allow write: if isProjectEditor();

        match /rows/{rowId} {
          allow read: if isProjectMember();
          allow write: if isProjectEditor();
        }
      }

      // Chat AI checkpoints (undo last turn)
      match /checkpoints/{checkpointId} {
        allow read: if isProjectMember();
        allow write: if isProjectEditor();
      }

      // API keys — hashes; writes only via Admin SDK
      match /apiKeys/{keyId} {
        allow read, write: if false;
      }

      // Deploy snapshots for rollback — read owner; write via Admin
      match /deployHistory/{histId} {
        allow read: if isProjectOwner();
        allow write: if false;
      }

      // Env secrets — Admin SDK only
      match /envSecrets/{secretId} {
        allow read, write: if false;
      }

      match /backendFunctions/{fnId} {
        allow read, write: if false;
        match /logs/{logId} {
          allow read, write: if false;
        }
      }
    }

    // Publicações partilháveis — leitura aberta (só snapshot de ficheiros, sem chat).
    // Free e Pro podem publicar preview/produção (badge Free via showBadge).
    // Production writes preferenciais via Admin /api/deploy; cliente também permitido ao owner.
    match /publicProjects/{pubId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'projectId', 'ownerId', 'name', 'env', 'files', 'url', 'updatedAt'
        ])
        && request.resource.data.env in ['preview', 'production']
        && (!('plan' in request.resource.data)
          || request.resource.data.plan in ['free', 'pro', 'enterprise_master'])
        && (!('showBadge' in request.resource.data)
          || request.resource.data.showBadge is bool)
        && (!('backendEnabled' in request.resource.data)
          || request.resource.data.backendEnabled is bool)
        && (!('authAccess' in request.resource.data)
          || request.resource.data.authAccess is map)
        && (!('ownerEmail' in request.resource.data)
          || request.resource.data.ownerEmail is string
          || request.resource.data.ownerEmail == null);

      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.env in ['preview', 'production'];

      allow delete: if isSignedIn()
        && (
          resource.data.ownerId == request.auth.uid
          || (
            'projectId' in resource.data
            && get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.ownerId
              == request.auth.uid
          )
        );
    }

    // Custom public path registry: /p/{slug} → projectId (writes via Admin /api/deploy)
    match /projectSlugs/{slug} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    // Custom domains — writes via Admin SDK (/api/deploy/custom-domain)
    match /customDomains/{host} {
      allow read: if true;
      allow write: if false;
    }
  }
}
