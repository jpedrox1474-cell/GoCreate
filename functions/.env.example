# Env carregado automaticamente pelo Firebase Functions (v2) neste diretório.
# NÃO commitar valores reais (functions/.env está no .gitignore).

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mercado Pago — Pix preview precisa de TEST- (Payments API).
# APP_USR de test-user automático → "Unauthorized use of live credentials".
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_TEST_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=https://gocreate.web.app/api/billing/webhook
PUBLIC_APP_URL=https://gocreate.web.app

# GitHub OAuth App "GoCreate Export" (push/repos) — callback:
#   https://gocreate.web.app/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://gocreate.web.app/api/github/callback
# GITHUB_OAUTH_STATE_SECRET=

# Referência local da app "GoCreate Auth" (Firebase Auth provider — NÃO usada pela API).
# Callback Firebase: https://vexo-ef6e2.firebaseapp.com/__/auth/handler
# GITHUB_AUTH_CLIENT_ID=
# GITHUB_AUTH_CLIENT_SECRET=

# Stripe Checkout (billing GoCreate) + Stripe Connect OAuth (Conta do utilizador)
# Dashboard: https://dashboard.stripe.com/apikeys
# Connect Settings: https://dashboard.stripe.com/settings/connect → Client ID (ca_…)
# Redirect URI: https://gocreate.web.app/api/integrations/stripe/oauth/callback
# Webhook billing: https://gocreate.web.app/api/billing/stripe-webhook
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=

# PayPal OAuth (Login with PayPal) — sem colar Client Secret no browser
# Redirect: https://gocreate.web.app/api/integrations/paypal/oauth/callback
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox

# ---------------------------------------------------------------------------
# WhatsApp (VPS proxy) — /api/integrations/whatsapp/*
# ---------------------------------------------------------------------------
EVOLUTION_API_URL=https://api-zap.meubarberpro.com.br
# EVOLUTION_API_PUBLIC_URL=https://api-zap.meubarberpro.com.br
EVOLUTION_API_KEY=

# ---------------------------------------------------------------------------
# Meta — Instagram / Facebook (FB.login)
# ---------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
# META_GRAPH_API_VERSION=v19.0

# ---------------------------------------------------------------------------
# YouTube + TikTok OAuth
# ---------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

