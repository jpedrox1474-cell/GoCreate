# Env carregado automaticamente pelo Firebase Functions (v2) neste diretório.
# NÃO commitar valores reais (functions/.env está no .gitignore).

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mercado Pago — Pix preview precisa de TEST- (Payments API).
# Kill switch Assinar Pro/Turbo (default OFF). Reactivar: =true
MERCADOPAGO_BILLING_ENABLED=false
# APP_USR de test-user automático → "Unauthorized use of live credentials".
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_TEST_ACCESS_TOKEN=
# Chave pública (mesmo app do Access Token) — Payment Brick embutido
# Painel MP → Credenciais → Public Key (TEST-… / APP_USR-…)
MERCADOPAGO_PUBLIC_KEY=
# Assinatura secreta do painel Webhooks (NÃO usar OAuth Client Secret)
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=https://gocreate-app.web.app/api/billing/webhook
PUBLIC_APP_URL=https://gocreate-app.web.app

# Mercado Pago Connect OAuth (conta do vendedor — botão Integrações)
# Painel: https://www.mercadopago.com.br/developers/panel/app
# Redirect URI (obrigatório no painel da app):
#   https://gocreate-app.web.app/api/integrations/mercadopago/oauth/callback
# TEMP teste: pode reutilizar Client ID/Secret da app BarberPro — desde que o
# redirect acima esteja registado nessa app.
TENANT_MP_OAUTH_CLIENT_ID=
TENANT_MP_OAUTH_APP_ID=
TENANT_MP_OAUTH_APP_SECRET=
# Alternativas: MERCADOPAGO_OAUTH_CLIENT_ID / MERCADOPAGO_OAUTH_CLIENT_SECRET
# MP_OAUTH_PKCE=false

# GitHub OAuth App "GoCreate Export" (push/repos) — callback:
#   https://gocreate-app.web.app/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://gocreate-app.web.app/api/github/callback
# GITHUB_OAUTH_STATE_SECRET=

# Referência local da app "GoCreate Auth" (Firebase Auth provider — NÃO usada pela API).
# Callback Firebase: https://gen-lang-client-0968841856.firebaseapp.com/__/auth/handler
# GITHUB_AUTH_CLIENT_ID=
# GITHUB_AUTH_CLIENT_SECRET=

# Stripe Checkout (billing GoCreate) + Stripe Connect OAuth (Conta do utilizador)
# Dashboard: https://dashboard.stripe.com/apikeys
# Connect Settings: https://dashboard.stripe.com/settings/connect → Client ID (ca_…)
# Redirect URI: https://gocreate-app.web.app/api/integrations/stripe/oauth/callback
# Webhook billing: https://gocreate-app.web.app/api/billing/stripe-webhook
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=

# PayPal OAuth (Login with PayPal) — sem colar Client Secret no browser
# Console (MCP não cria apps PayPal): https://developer.paypal.com/dashboard/applications
# Return URL: https://gocreate-app.web.app/api/integrations/paypal/oauth/callback
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox

# ---------------------------------------------------------------------------
# WhatsApp (VPS proxy) — /api/integrations/whatsapp/*
# ---------------------------------------------------------------------------
EVOLUTION_API_URL=https://api-zap.meubarberpro.com.br
# EVOLUTION_API_PUBLIC_URL=https://api-zap.meubarberpro.com.br
EVOLUTION_API_KEY=

# ---------------------------------------------------------------------------
# Meta — Instagram / Facebook (FB.login) — App "Manu TV Hub" 1279478237613349
# ---------------------------------------------------------------------------
# Frontend: VITE_META_APP_ID em frontend/.env
# Consola (API write disabled): adicionar App Domains + JS SDK domains:
#   gocreate-app.web.app , gen-lang-client-0968841856.firebaseapp.com , localhost
# Valid OAuth Redirect URIs: https://gocreate-app.web.app/ , https://gocreate-app.web.app/integrations
META_APP_ID=
META_APP_SECRET=
# META_GRAPH_API_VERSION=v19.0

# ---------------------------------------------------------------------------
# YouTube + TikTok OAuth
# ---------------------------------------------------------------------------
# Redirects:
#   https://gocreate-app.web.app/api/integrations/youtube/oauth/callback
#   https://gocreate-app.web.app/api/integrations/tiktok/oauth/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

