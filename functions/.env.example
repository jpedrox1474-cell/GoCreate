# Env carregado automaticamente pelo Firebase Functions (v2) neste diretório.
# NÃO commitar valores reais (functions/.env está no .gitignore).

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mercado Pago — obrigatório para Pro/Turbo em produção
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=https://gocreate.web.app/api/billing/webhook
PUBLIC_APP_URL=https://gocreate.web.app

# GitHub OAuth App "GoCreate Export" (push/repos) — callback:
#   https://gocreate.web.app/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://gocreate.web.app/api/github/callback
# GITHUB_OAUTH_STATE_SECRET=

# Referência local da app "GoCreate Auth" (Firebase Auth provider — NÃO usada pela API).
# Callback Firebase: https://vexo-ef6e2.firebaseapp.com/__/auth/handler
# GITHUB_AUTH_CLIENT_ID=
# GITHUB_AUTH_CLIENT_SECRET=

# Stripe Checkout (opcional — cartão internacional Pro)
# Dashboard: https://dashboard.stripe.com/apikeys
# Webhook endpoint: https://gocreate.web.app/api/billing/stripe-webhook
# Events: checkout.session.completed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
