# Config pública do Firebase (client-side).
# Pegue esses valores em: Firebase Console > Configurações do Projeto > Seus Apps > SDK setup
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL do backend.
# Local: http://localhost:4000
# Produção (gocreate.web.app): deixe VAZIO para usar same-origin /api/* (rewrite → Cloud Function gocreateApi)
# NÃO deixe o frontend em produção a apontar para localhost — o chat falha e deixa de gerar apps.
VITE_API_URL=http://localhost:4000

# Só para demos locais sem backend. Em produção NÃO definir / deixar false.
# VITE_USE_MOCK_CHAT=true
