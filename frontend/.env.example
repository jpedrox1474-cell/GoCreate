# Config pública do Firebase (client-side).
# Pegue esses valores em: Firebase Console > Configurações do Projeto > Seus Apps > SDK setup
# Projeto atual: gen-lang-client-0968841856 (display name: GoCreate)
# Console: https://console.firebase.google.com/project/gen-lang-client-0968841856/overview
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=gen-lang-client-0968841856.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=gen-lang-client-0968841856
VITE_FIREBASE_STORAGE_BUCKET=gen-lang-client-0968841856.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL do backend.
# Local: http://localhost:4000
# Produção (gocreate-app.web.app): deixe VAZIO para usar same-origin /api/* (rewrite → Cloud Function gocreateApi)
# NÃO deixe o frontend em produção a apontar para localhost — o chat falha e deixa de gerar apps.
VITE_API_URL=http://localhost:4000

# Só para demos locais sem backend. Em produção NÃO definir / deixar false.
# VITE_USE_MOCK_CHAT=true

# ---------------------------------------------------------------------------
# Meta — Instagram / Facebook (público; mesmo App ID do backend META_APP_ID)
# ---------------------------------------------------------------------------
# Necessário para FB.login (JS SDK) na secção Canais de Atendimento & Social.
# NÃO colocar META_APP_SECRET aqui.
VITE_META_APP_ID=
# Opcional: pedir scopes avançados (publish/messaging) — exige App Review Meta
# VITE_META_REQUEST_ADVANCED_SCOPES=false

# ---------------------------------------------------------------------------
# LEGACY (vexo-ef6e2) — rollback only; site gocreate.web.app ainda vive nesse projeto
# ---------------------------------------------------------------------------
# VITE_FIREBASE_PROJECT_ID=vexo-ef6e2
# VITE_FIREBASE_AUTH_DOMAIN=vexo-ef6e2.firebaseapp.com
