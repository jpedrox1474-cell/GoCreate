# Servidor
PORT=4000

# Google Gemini (assistente de geração — POST /api/chat). Nunca expor no frontend.
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Prefer gemini-flash-lite-latest on free-tier keys (quota mais estável)
GEMINI_MODEL=gemini-flash-lite-latest

# ---------------------------------------------------------------------------
# AI fallback multi-provider (OpenAI SDK) — Groq → OpenRouter → GitHub Models
# Usado por backend/services/aiFallbackService.js quando Gemini falha / sem chave.
# Deixe vazio e cole as chaves localmente (NUNCA commitar valores reais).
# ---------------------------------------------------------------------------
# Groq: https://console.groq.com/keys  (baseURL https://api.groq.com/openai/v1)
GROQ_API_KEY=
# OPENROUTER: https://openrouter.ai/keys  (baseURL https://openrouter.ai/api/v1)
OPENROUTER_API_KEY=
# GitHub Models: PAT com scope models:read
# Preferir GITHUB_MODELS_TOKEN (evita conflito com Actions GITHUB_TOKEN).
# Fallback: GITHUB_TOKEN se GITHUB_MODELS_TOKEN estiver vazio.
# baseURL OpenAI-compatible: https://models.github.ai/inference
GITHUB_MODELS_TOKEN=
# GITHUB_TOKEN=
# Opcionais (overrides de modelo):
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=openrouter/free
# GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# Firebase Admin SDK — pegue em: Firebase Console > Configurações do Projeto
# > Contas de Serviço > Gerar nova chave privada (baixa um JSON, copie os 3 campos abaixo)
# Projeto GoCreate dedicado: gen-lang-client-0968841856 (alias gocreate)
# Legado (não usar para GoCreate): vexo-ef6e2
FIREBASE_PROJECT_ID=gen-lang-client-0968841856
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Alternativa: caminho para o JSON da service account
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Cloudinary — upload de anexos do chat (POST /api/upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Mercado Pago (billing — Pro R$49 + Turbo)
# ---------------------------------------------------------------------------
# Kill switch do checkout Assinar Pro / Turbo (default ON se omitido).
# Desligar só em emergência: MERCADOPAGO_BILLING_ENABLED=false
MERCADOPAGO_BILLING_ENABLED=true
# Access Token: https://www.mercadopago.com.br/developers/panel/app
# Pix / Payments API no preview: use TEST-... (Checkout API).
# APP_USR de test-user automático falha em /v1/payments com
# "Unauthorized use of live credentials".
MERCADOPAGO_ACCESS_TOKEN=
# Preferido por GoCreatePayments / public-create-payment (sandbox Pix QR)
MERCADOPAGO_TEST_ACCESS_TOKEN=
# Chave pública (mesmo app do Access Token) — Payment Brick / GET /api/billing/config
# Painel: Credenciais de teste ou produção → Public Key (TEST-… ou APP_USR-…)
MERCADOPAGO_PUBLIC_KEY=
# Opcional: Assinatura secreta do painel Webhooks (NÃO o OAuth Client Secret)
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública do webhook (Hosting rewrite → gocreateApi). Configure a MESMA URL
# no painel MP (Webhooks → Payments):
#   https://gocreate-app.web.app/api/billing/webhook
# Alternativa Cloud Function direta:
#   https://southamerica-east1-gen-lang-client-0968841856.cloudfunctions.net/gocreateApi/api/billing/webhook
MERCADOPAGO_NOTIFICATION_URL=https://gocreate-app.web.app/api/billing/webhook
# Front para back_urls do Checkout Preference
PUBLIC_APP_URL=https://gocreate-app.web.app

# Mercado Pago Connect OAuth (vendedor — Integrações → Conectar com Mercado Pago)
# Redirect URI a registar no painel MP:
#   https://gocreate-app.web.app/api/integrations/mercadopago/oauth/callback
# TEMP: app BarberPro OK para teste se o redirect GoCreate estiver na app.
TENANT_MP_OAUTH_CLIENT_ID=
TENANT_MP_OAUTH_APP_ID=
TENANT_MP_OAUTH_APP_SECRET=
# MERCADOPAGO_OAUTH_CLIENT_ID=
# MERCADOPAGO_OAUTH_CLIENT_SECRET=
# MP_OAUTH_PKCE=false

# ---------------------------------------------------------------------------
# GitHub OAuth App — export "Push to GitHub" (criar repo + commit)
# ---------------------------------------------------------------------------
# 1. https://github.com/settings/developers → New OAuth App
# 2. Application name: GoCreate Export
# 3. Homepage URL: https://gocreate.web.app
# 4. Authorization callback URL (obrigatório — 1 por OAuth App):
#      https://gocreate.web.app/api/github/callback
#    (Hosting rewrite /api/** → Cloud Function gocreateApi)
# 5. Copia Client ID + gera Client Secret → cola abaixo
# 6. Sync: functions/.env (mesmo valores) + redeploy gocreateApi
#
# NOTA — Login com GitHub (Firebase Auth) usa OUTRA OAuth App (ou a mesma
# se só usares login), com callback:
#   https://gen-lang-client-0968841856.firebaseapp.com/__/auth/handler
#   https://gocreate-app.web.app/__/auth/handler
# Como cada OAuth App só tem 1 callback URL, cria apps separadas:
#   - "GoCreate Export" → /api/github/callback (variáveis abaixo)
#   - "GoCreate Auth"   → Firebase handler (consola Firebase → Authentication → GitHub)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://gocreate-app.web.app/api/github/callback
# Opcional: secret dedicado para assinar o state OAuth (default = CLIENT_SECRET)
# GITHUB_OAUTH_STATE_SECRET=

# ---------------------------------------------------------------------------
# Stripe Checkout (billing) + Stripe Connect OAuth (conta do criador)
# ---------------------------------------------------------------------------
# 1. https://dashboard.stripe.com/apikeys → Secret key (sk_…)
# 2. Connect → Settings → Integration → Client ID (ca_…)
# 3. Redirect URI: https://gocreate.web.app/api/integrations/stripe/oauth/callback
# 4. Webhook billing: https://gocreate.web.app/api/billing/stripe-webhook
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# PayPal OAuth (Login with PayPal) — platform client; utilizador liga via OAuth
# ---------------------------------------------------------------------------
# Console (MCP não cria apps PayPal): https://developer.paypal.com/dashboard/applications
# 1. Create app (Sandbox ou Live)
# 2. Enable Login with PayPal
# 3. Return URL: https://gocreate.web.app/api/integrations/paypal/oauth/callback
# 4. Cole Client ID + Secret abaixo e redeploy functions
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox

# ---------------------------------------------------------------------------
# WhatsApp (VPS proxy) — chaves só no servidor
# ---------------------------------------------------------------------------
# NUNCA expor EVOLUTION_API_KEY no frontend — proxy em /api/integrations/whatsapp/*
EVOLUTION_API_URL=https://api-zap.meubarberpro.com.br
# EVOLUTION_API_PUBLIC_URL=https://api-zap.meubarberpro.com.br
EVOLUTION_API_KEY=

# ---------------------------------------------------------------------------
# Meta — Instagram / Facebook (FB.login)
# ---------------------------------------------------------------------------
# App em https://developers.facebook.com/apps/
# Frontend: VITE_META_APP_ID (público) em frontend/.env
META_APP_ID=
META_APP_SECRET=
# META_GRAPH_API_VERSION=v19.0
# Facebook Login → Settings: ative “Login with the JavaScript SDK”
# App Domains + Allowed Domains for JS SDK MUST include:
#   gocreate.web.app
#   gocreate.firebaseapp.com
#   localhost (dev)
# Valid OAuth Redirect URIs (Login):
#   https://gocreate.web.app/
#   https://gocreate.web.app/integrations
# Privacy/Terms: prefer https://gocreate.web.app/... (MCP cannot write app_domains —
# enable “changes via API” in Advanced, or edit in console).

# ---------------------------------------------------------------------------
# YouTube + TikTok OAuth (popup)
# ---------------------------------------------------------------------------
# Redirect URIs a registar nos consoles:
#   {PUBLIC_APP_URL}/api/integrations/youtube/oauth/callback
#   {PUBLIC_APP_URL}/api/integrations/tiktok/oauth/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

