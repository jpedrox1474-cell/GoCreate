# Servidor
PORT=4000

# Google Gemini (assistente de geração — POST /api/chat). Nunca expor no frontend.
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Prefer gemini-flash-lite-latest on free-tier keys (quota mais estável)
GEMINI_MODEL=gemini-flash-lite-latest

# Firebase Admin SDK — pegue em: Firebase Console > Configurações do Projeto
# > Contas de Serviço > Gerar nova chave privada (baixa um JSON, copie os 3 campos abaixo)
# Projeto GoCreate / hosting: vexo-ef6e2
FIREBASE_PROJECT_ID=vexo-ef6e2
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Alternativa: caminho para o JSON da service account
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Cloudinary — upload de anexos do chat (POST /api/upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Mercado Pago (billing — Pro R$49 + Turbo Pix R$20)
# ---------------------------------------------------------------------------
# Access Token: https://www.mercadopago.com.br/developers/panel/app
# Use TEST-... para sandbox; APP_USR-... para produção.
MERCADOPAGO_ACCESS_TOKEN=
# Opcional: secret do webhook (Suas integrações → Webhooks → Assinatura secreta)
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública do webhook (Hosting rewrite → gocreateApi). Configure a MESMA URL
# no painel MP (Webhooks → Payments):
#   https://gocreate.web.app/api/billing/webhook
# Alternativa Cloud Function direta:
#   https://southamerica-east1-vexo-ef6e2.cloudfunctions.net/gocreateApi/api/billing/webhook
MERCADOPAGO_NOTIFICATION_URL=https://gocreate.web.app/api/billing/webhook
# Front para back_urls do Checkout Preference
PUBLIC_APP_URL=https://gocreate.web.app

# ---------------------------------------------------------------------------
# GitHub OAuth App — export "Push to GitHub" (criar repo + commit)
# ---------------------------------------------------------------------------
# 1. https://github.com/settings/developers → New OAuth App
# 2. Application name: GoCreate Export
# 3. Homepage URL: https://gocreate.web.app
# 4. Authorization callback URL (obrigatório — 1 por OAuth App):
#      https://gocreate.web.app/api/github/callback
#    (Hosting rewrite /api/** → Cloud Function gocreateApi)
# 5. Copia Client ID + gera Client Secret → cola abaixo
# 6. Sync: functions/.env (mesmo valores) + redeploy gocreateApi
#
# NOTA — Login com GitHub (Firebase Auth) usa OUTRA OAuth App (ou a mesma
# se só usares login), com callback:
#   https://vexo-ef6e2.firebaseapp.com/__/auth/handler
#   https://gocreate.web.app/__/auth/handler
# Como cada OAuth App só tem 1 callback URL, cria apps separadas:
#   - "GoCreate Export" → /api/github/callback (variáveis abaixo)
#   - "GoCreate Auth"   → Firebase handler (consola Firebase → Authentication → GitHub)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://gocreate.web.app/api/github/callback
# Opcional: secret dedicado para assinar o state OAuth (default = CLIENT_SECRET)
# GITHUB_OAUTH_STATE_SECRET=

# ---------------------------------------------------------------------------
# Stripe Checkout (opcional — Pro com cartão internacional)
# ---------------------------------------------------------------------------
# 1. https://dashboard.stripe.com/apikeys → Secret key (sk_… ou rk_…)
# 2. Webhooks → Add endpoint:
#      https://gocreate.web.app/api/billing/stripe-webhook
#    Event: checkout.session.completed → copia Signing secret (whsec_…)
# 3. Cola abaixo + em functions/.env e redeploy gocreateApi
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Evolution API (WhatsApp) — VPS / proxy backend (padrão BarberPro)
# ---------------------------------------------------------------------------
# URL pública da Evolution (ex.: https://api-zap.meubarberpro.com.br)
# NUNCA expor EVOLUTION_API_KEY no frontend — o proxy em /api/integrations/whatsapp/*
# usa estas variáveis no servidor (Cloud Functions / backend local).
EVOLUTION_API_URL=https://api-zap.meubarberpro.com.br
# Opcional: URL pública mostrada em logs/UI (fallback = EVOLUTION_API_URL)
# EVOLUTION_API_PUBLIC_URL=https://api-zap.meubarberpro.com.br
EVOLUTION_API_KEY=
# firebase functions:secrets:set EVOLUTION_API_KEY  (produção)

# ---------------------------------------------------------------------------
# Meta — Instagram / Facebook (padrão ManuTV Social Hub)
# ---------------------------------------------------------------------------
# App em https://developers.facebook.com/apps/
# Frontend também precisa de VITE_META_APP_ID (público) em frontend/.env
META_APP_ID=
META_APP_SECRET=
# META_GRAPH_API_VERSION=v19.0
# Em Facebook Login → Settings: ative “Login with the JavaScript SDK”
# Allowed Domains: gocreate.web.app (e localhost para dev)

