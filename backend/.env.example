# Servidor
PORT=4000

# Google Gemini (assistente de geração — POST /api/chat). Nunca expor no frontend.
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Prefer gemini-flash-lite-latest on free-tier keys (quota mais estável)
GEMINI_MODEL=gemini-flash-lite-latest

# Firebase Admin SDK — pegue em: Firebase Console > Configurações do Projeto
# > Contas de Serviço > Gerar nova chave privada (baixa um JSON, copie os 3 campos abaixo)
# Projeto GoCreate / hosting: vexo-ef6e2
FIREBASE_PROJECT_ID=vexo-ef6e2
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Alternativa: caminho para o JSON da service account
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Cloudinary — upload de anexos do chat (POST /api/upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Mercado Pago (billing — Pro R$49 + Turbo Pix R$20)
# ---------------------------------------------------------------------------
# Access Token: https://www.mercadopago.com.br/developers/panel/app
# Use TEST-... para sandbox; APP_USR-... para produção.
MERCADOPAGO_ACCESS_TOKEN=
# Opcional: secret do webhook (Suas integrações → Webhooks → Assinatura secreta)
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública do webhook (Hosting rewrite → gocreateApi). Configure a MESMA URL
# no painel MP (Webhooks → Payments):
#   https://gocreate.web.app/api/billing/webhook
# Alternativa Cloud Function direta:
#   https://southamerica-east1-vexo-ef6e2.cloudfunctions.net/gocreateApi/api/billing/webhook
MERCADOPAGO_NOTIFICATION_URL=https://gocreate.web.app/api/billing/webhook
# Front para back_urls do Checkout Preference
PUBLIC_APP_URL=https://gocreate.web.app

# TODO(stripe): STRIPE_SECRET_KEY=  STRIPE_WEBHOOK_SECRET=
